# /etc/bitpin-bot/bitpin-bot.env - secrets and the Kimi proxy for the Bitpin bot services.
# Read by systemd (EnvironmentFile=) and by "sudo bitpin-bot ...". Edit with:
#     sudo nano /etc/bitpin-bot/bitpin-bot.env
#
# Format: one NAME=value per line. No spaces around "=", no quotes, no "export". Lines starting
# with # are comments. After editing: sudo systemctl restart bitpin-bot (if it is running).
#
# SECURITY
# * This file must stay mode 0600, owner root, group root (install.sh / update.sh set that: only systemd
#   and the root helper read it, never a process of user bitpin). Check with:
#       sudo ls -l /etc/bitpin-bot/bitpin-bot.env
# * Keep the keys ONLY here (and in a password manager). Never put them in OneDrive / Google Drive /
#   Dropbox, git, e-mail, Telegram or screenshots. Delete any copy on your PC once the bot runs.
# * The Bitpin key needs trading permission only - never withdrawal permission - and must be limited
#   to this server's outbound IP (the IP whitelist in the Bitpin panel; "sudo bitpin-bot check"
#   prints the IPs it sees).
# * If a key leaks: delete it in the Bitpin panel / Moonshot console immediately, then make a new one.

# Bitpin API key pair (Bitpin panel -> API management)
BITPIN_API_KEY=
BITPIN_SECRET_KEY=

# Kimi (Moonshot AI) API key, used by both stages (news research and decisions). A key from
# platform.moonshot.ai works only with https://api.moonshot.ai/v1, a key from platform.moonshot.cn
# only with https://api.moonshot.cn/v1 (the base_url in /etc/bitpin-bot/kimi.json must match).
KIMI_API_KEY=

# Optional: starting capital (toman) of a NEW paper account for bitpin-bot-paper.service
# (default 5000000). Leaving it EMPTY is allowed: the paper broker then
# uses its own default. It only matters the first time; later starts resume the paper account.
#PAPER_CAPITAL_IRT=5000000

# Kimi (Moonshot) traffic ONLY: the local HTTP proxy through which this server reaches Moonshot.
# The bot sends only its Kimi requests (both stages) through it and retries dropped connections;
# Bitpin is ALWAYS reached directly (so Bitpin sees this server's own IP), whatever http_proxy /
# https_proxy / ALL_PROXY / NO_PROXY variables the server has. Do not add a NO_PROXY line here.
# Check it with:
#     sudo bitpin-bot kimi-check --news
KIMI_HTTPS_PROXY=http://127.0.0.1:1081
