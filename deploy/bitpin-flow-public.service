# Optional PUBLIC-data service, installed explicitly by the owner. No account or model access.
# Requires a dedicated unprivileged bitpin-flow system user/group and root-owned code.
# State contains only public observations and is readable by the trader; writable only by bitpin-flow.
[Unit]
Description=Bitpin public daily-flow observations
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bitpin-flow
Group=bitpin-flow
WorkingDirectory=/opt/bitpin-flow-public
ExecStart=/usr/bin/python3 -B scripts/flow_shadow.py --state-dir /var/lib/bitpin-flow-public --continuous --interval 30
Environment=TZ=UTC PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=30
TimeoutStopSec=90
StateDirectory=bitpin-flow-public
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/etc/bitpin-bot -/var/lib/bitpin-bot -/var/lib/bitpin-bot-paper -/opt/bitpin-bot -/opt/xray
ReadWritePaths=/var/lib/bitpin-flow-public
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=160M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
