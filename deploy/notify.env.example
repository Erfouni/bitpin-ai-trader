# /etc/bitpin-bot/notify.env - secrets of the Telegram notifier (bitpin-bot-notify.service) ONLY.
# Read by systemd (EnvironmentFile=) and by "sudo bitpin-bot notify-...". Edit with:
#     sudo nano /etc/bitpin-bot/notify.env        then: sudo systemctl restart bitpin-bot-notify
# Format: NAME=value, no spaces around "=", no quotes. Mode 0600 root:root (install.sh / update.sh set it).
# NEVER put BITPIN_API_KEY / BITPIN_SECRET_KEY here: the notifier never needs them and never reads them.
# Guide: /opt/bitpin-bot/docs/TELEGRAM_FA.md

# Bot token from @BotFather (/newbot). It is a secret: never share it or take screenshots of it.
TELEGRAM_BOT_TOKEN=

# Your numeric PRIVATE chat id(s), comma-separated (sudo bitpin-bot notify-setup shows them after you sent
# /start; anyone can write to a bot - pick YOUR line by your @username). Only these chats receive messages,
# and commands are accepted only in the private chat with the bot (a group id receives messages - every
# member sees the balances - but commands there are refused).
TELEGRAM_CHAT_ID=

# Telegram is usually blocked directly from servers in Iran: the notifier reaches it ONLY through this local HTTP proxy
# (the same one Kimi uses). No other proxy variable is read.
TELEGRAM_HTTPS_PROXY=http://127.0.0.1:1081

# Optional: Persian translation of Kimi's English reasoning (the same key as in bitpin-bot.env).
#KIMI_API_KEY=
#KIMI_HTTPS_PROXY=http://127.0.0.1:1081
